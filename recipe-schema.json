{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Recipe Dataset Schema",
  "type": "array",
  "items": {
    "type": "object",
    "required": ["id", "title", "category", "image"],
    "properties": {
      "id": {
        "type": "string"
      },
      "title": {
        "type": "string"
      },
      "category": {
        "type": "string"
      },
      "keywords": {
        "type": "string"
      },
      "prepTime": {
        "type": "string"
      },
      "cookTime": {
        "type": "string"
      },
      "servings": {
        "type": "string"
      },
      "image": {
        "type": "string",
        "format": "uri"
      },
      "ingredients": {
        "type": "array",
        "items": {
          "type": "string"
        }
      },
      "instructions": {
        "type": "array",
        "items": {
          "type": "string"
        }
      },
      "baseIngredients": {
        "type": "array",
        "items": {
          "type": "object",
          "required": ["name", "amount"],
          "properties": {
            "name": { "type": "string" },
            "amount": { "type": "string" }
          }
        }
      },
      "baseInstructions": {
        "type": "array",
        "items": {
          "type": "string"
        }
      },
      "variants": {
        "type": "array",
        "items": {
          "type": "object",
          "required": ["variantName", "additionalIngredients", "instructionModifications"],
          "properties": {
            "variantName": { "type": "string" },
            "additionalIngredients": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["name", "amount"],
                "properties": {
                  "name": { "type": "string" },
                  "amount": { "type": "string" }
                }
              }
            },
            "instructionModifications": {
              "type": "array",
              "items": { "type": "string" }
            }
          }
        }
      },
      "notes": {
        "type": "string"
      }
    }
  }
}
