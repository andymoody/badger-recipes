{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Recipe Dataset Schema",
  "type": "array",
  "items": {
    "$ref": "#/definitions/recipe"
  },
  "definitions": {
    "ingredient": {
      "oneOf": [
        { "type": "string" },
        {
          "type": "object",
          "required": ["name", "amount"],
          "properties": {
            "name": { "type": "string" },
            "amount": { "type": "string" },
            "unit": { "type": "string" }
          }
        }
      ]
    },
    "variant": {
      "type": "object",
      "required": ["name"],
      "anyOf": [
        { "required": ["ingredients"] },
        { "required": ["instructions"] }
      ],
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "ingredients": {
          "type": "array",
          "items": { "$ref": "#/definitions/ingredient" }
        },
        "instructions": {
          "type": "array",
          "items": { "type": "string" }
        },
        "notes": { "type": "string" }
      }
    },
    "component": {
      "type": "object",
      "required": ["name"],
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "description": { "type": "string" },
        "ingredients": {
          "type": "array",
          "items": { "$ref": "#/definitions/ingredient" }
        },
        "instructions": {
          "type": "array",
          "items": { "type": "string" }
        },
        "variants": {
          "type": "array",
          "items": { "$ref": "#/definitions/variant" }
        }
      }
    },
    "recipe": {
      "type": "object",
      "required": ["id", "title", "category", "image"],
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "category": { "type": "string" },
        "keywords": { "type": "string" },
        "prepTime": { "type": "string" },
        "cookTime": { "type": "string" },
        "servings": { "type": "string" },
        "image": { "type": "string", "format": "uri" },
        "ingredients": {
          "type": "array",
          "items": { "$ref": "#/definitions/ingredient" }
        },
        "instructions": {
          "type": "array",
          "items": { "type": "string" }
        },
        "variants": {
          "type": "array",
          "items": { "$ref": "#/definitions/variant" }
        },
        "components": {
          "type": "array",
          "items": { "$ref": "#/definitions/component" }
        },
        "notes": { "type": "string" }
      }
    }
  }
}
